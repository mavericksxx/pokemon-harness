{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    // Mirrors astro.config.mjs's vite.resolve.alias (the showreel imports
    // the desktop app's real garden modules). The audio stub alias is exact-
    // path, so it's listed ahead of the general `@/*` pattern.
    "paths": {
      "@/audio/audioEngine": ["src/showreel/audioStub.ts"],
      "@/*": ["../src/renderer/src/*"],
      "@shared/*": ["../src/shared/*"],
      "@assets/*": ["../assets/*"]
    }
  }
}
