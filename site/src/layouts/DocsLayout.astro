---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  currentId: string;
}

const { title, currentId } = Astro.props;

const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const index = allDocs.findIndex((d) => d.id === currentId);
const prev = index > 0 ? allDocs[index - 1] : undefined;
const next = index >= 0 && index < allDocs.length - 1 ? allDocs[index + 1] : undefined;
const pad = (n: number): string => String(n).padStart(2, '0');
---

<BaseLayout title={`${title} · pokéharness docs`} current="docs">
  <div class="wrap docs-shell">
    <nav class="docs-index" aria-label="docs">
      <details class="docs-index-details" open>
        <summary class="docs-index-title">docs</summary>
        <ol>
          {allDocs.map((doc, i) => (
            <li>
              <a href={`/docs/${doc.id}/`} aria-current={doc.id === currentId ? 'page' : undefined}>
                <span class="docs-index-num">{pad(i + 1)}</span>
                <span>{doc.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
    <article class="docs-body">
            <h1>{title}</h1>
      <div class="prose">
        <slot />
      </div>
      <nav class="docs-pager" aria-label="more docs">
        {prev ? <a href={`/docs/${prev.id}/`}><span>← previous</span>{prev.data.title}</a> : <span />}
        {next && <a class="docs-pager-next" href={`/docs/${next.id}/`}><span>next →</span>{next.data.title}</a>}
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: flex;
    gap: 48px;
    align-items: flex-start;
    padding-top: 40px;
  }

  .docs-index {
    width: 236px;
    flex-shrink: 0;
    position: sticky;
    top: 24px;
  }
  .docs-index-title {
    font-family: var(--font-pixel);
    font-size: 8px;
    line-height: 16px;
    color: var(--text);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    list-style: none;
    cursor: default;
  }
  .docs-index-title::-webkit-details-marker {
    display: none;
  }
  .docs-index ol {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .docs-index a {
    display: flex;
    gap: 10px;
    padding: 6px 8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-soft);
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .docs-index a:hover {
    color: var(--text);
  }
  .docs-index a[aria-current='page'] {
    color: var(--text);
    border-left-color: var(--gold);
    background: var(--gold-wash);
  }
  .docs-index-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    padding-top: 2px;
  }

  .docs-body {
    flex: 1;
    min-width: 0;
    max-width: 700px;
  }
  .docs-kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 10px;
  }
  h1 {
    font-weight: 650;
    letter-spacing: -0.02em;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.12;
    margin: 0 0 28px;
  }

  /* The doc body comes through <slot /> from astro:content and doesn't carry
     this file's scoping attribute, hence :global() under .prose. */
  .prose :global(p),
  .prose :global(li) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-soft);
  }
  .prose :global(p) {
    margin: 0 0 18px;
  }
  .prose :global(h2) {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 22px;
    color: var(--text);
    margin: 40px 0 12px;
  }
  .prose :global(h3) {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 18px;
    color: var(--text);
    margin: 28px 0 10px;
  }
  .prose :global(strong),
  .prose :global(em) {
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--text);
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 22px;
    margin: 0 0 18px;
  }
  .prose :global(li) {
    margin: 0 0 6px;
  }
  .prose :global(li::marker) {
    color: var(--muted);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text);
    background: var(--panel-2);
    padding: 1px 5px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .prose :global(p code),
  .prose :global(li code) {
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    background: var(--term-bg) !important;
    border: 1px solid var(--line);
    color: var(--term-ink);
    padding: 16px 18px;
    overflow-x: auto;
    margin: 0 0 22px;
    font-size: 13px;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
    box-shadow: none;
  }
  .prose :global(blockquote) {
    margin: 0 0 18px;
    padding: 4px 0 4px 18px;
    border-left: 2px solid var(--line-strong);
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 0 0 22px;
    font-size: 14px;
  }
  .prose :global(th),
  .prose :global(td) {
    border-bottom: 1px solid var(--line);
    padding: 6px 12px 6px 0;
    text-align: left;
    color: var(--text-soft);
  }
  .prose :global(img) {
    height: auto;
  }

  .docs-pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .docs-pager a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 17px;
    color: var(--text);
  }
  .docs-pager a span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .docs-pager-next {
    text-align: right;
    margin-left: auto;
  }
  .docs-pager a:hover {
    color: var(--gold-hi);
  }

  @media (max-width: 820px) {
    .docs-shell {
      flex-direction: column;
      gap: 24px;
      padding-top: 24px;
    }
    .docs-index {
      position: static;
      width: 100%;
    }
    .docs-index-title {
      cursor: pointer;
    }
    .docs-index-title::after {
      content: ' ▾';
      font-style: normal;
      font-size: 12px;
      color: var(--muted);
    }
  }
</style>

<script>
  // Collapse the index on narrow screens so the note itself comes first.
  const details = document.querySelector<HTMLDetailsElement>('.docs-index-details');
  if (details && window.matchMedia('(max-width: 820px)').matches) details.open = false;
</script>
