---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  currentId: string;
}

const { title, currentId } = Astro.props;

const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} · pokéharness docs</title>
<link rel="icon" type="image/png" href="/favicon.png">

<style>
  @font-face {
    font-family: 'Press Start 2P';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/press-start-2p-latin-400.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/inter-latin-var.woff2') format('woff2');
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-latin-var.woff2') format('woff2');
  }

  :root {
    --ground-0: #17171B;
    --ground-100: #1D1D22;
    --ground-200: #26262C;
    --border: #787684;
    --ink-900: #DEDBD6;
    --ink-700: #B3B0AC;
    --ink-500: #96919F;
    --gold: #E8B740;
    --on-accent: #1A1320;
    --font-display: 'Press Start 2P', monospace;
    --font-ui: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  * { box-sizing: border-box; }

  html { color-scheme: dark; }

  body {
    margin: 0;
    background: var(--ground-0);
    color: var(--ink-900);
    font-family: var(--font-ui);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a { color: var(--gold); }

  :focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  /* ── topbar ───────────────────────────────────────────────────────── */
  .topbar {
    border-bottom: 1px solid rgba(120, 118, 132, 0.2);
    padding: 16px 24px;
  }
  .topbar a.brand {
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--gold);
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  /* ── layout ───────────────────────────────────────────────────────── */
  .docs-shell {
    display: flex;
    max-width: 1100px;
    margin: 0 auto;
    align-items: flex-start;
  }

  .sidebar {
    width: 220px;
    flex-shrink: 0;
    padding: 40px 24px;
  }
  .sidebar h2 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-500);
    margin: 0 0 12px;
  }
  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sidebar li {
    margin: 0 0 4px;
  }
  .sidebar a {
    display: block;
    padding: 6px 10px;
    font-size: 14px;
    color: var(--ink-700);
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .sidebar a:hover {
    color: var(--ink-900);
  }
  .sidebar a.active {
    color: var(--gold);
    border-left-color: var(--gold);
    background: var(--ground-100);
  }

  /* ── content ──────────────────────────────────────────────────────── */
  main {
    flex: 1;
    min-width: 0;
    padding: 40px 24px 80px;
    max-width: 680px;
  }
  main h1 {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 24px;
    color: var(--ink-900);
  }
  main h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 32px 0 12px;
    color: var(--ink-900);
  }
  main p {
    font-size: 15px;
    color: var(--ink-700);
    margin: 0 0 16px;
  }
  main strong {
    color: var(--ink-900);
  }
  main ul, main ol {
    color: var(--ink-700);
    font-size: 15px;
    padding-left: 20px;
    margin: 0 0 16px;
  }
  main li {
    margin: 0 0 6px;
  }
  main code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--ground-100);
    color: var(--gold);
    padding: 2px 5px;
    box-shadow: inset 0 0 0 1px rgba(120, 118, 132, 0.2);
  }
  main pre {
    background: var(--ground-100);
    box-shadow: inset 0 0 0 1px rgba(120, 118, 132, 0.2);
    padding: 16px;
    overflow-x: auto;
    margin: 0 0 20px;
  }
  main pre code {
    background: none;
    color: var(--ink-900);
    padding: 0;
    box-shadow: none;
  }
  main em {
    color: var(--ink-900);
  }

  @media (max-width: 700px) {
    .docs-shell { flex-direction: column; }
    .sidebar { width: 100%; padding: 24px 24px 0; }
    main { max-width: none; }
  }
</style>
</head>
<body>

<div class="topbar">
  <a class="brand" href="/">pokéharness</a>
</div>

<div class="docs-shell">
  <nav class="sidebar">
    <h2>Docs</h2>
    <ul>
      {allDocs.map((doc) => (
        <li>
          <a href={`/docs/${doc.id}/`} class={doc.id === currentId ? 'active' : ''}>
            {doc.data.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <main>
    <h1>{title}</h1>
    <slot />
  </main>
</div>

</body>
</html>
