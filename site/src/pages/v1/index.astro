---
import VariantLayout from '../../layouts/VariantLayout.astro';
import VariantHero from '../../components/VariantHero.astro';
import Showreel from '../../components/Showreel.astro';
---

<VariantLayout variant="v1" themeColor="#17171b">
  <section class="wrap v1-intro"><VariantHero /></section>
  <Showreel fitMargin={48} />
</VariantLayout>

<style is:global>
  /* v1 "match the app": the app's own tokens (src/renderer/src/index.css). */
  body.v1 {
    --page-bg: #17171b;
    --panel: #1d1d22;
    --panel-2: #26262c;
    --page-text: #dedbd6;
    --page-muted: #96919f;
    --page-line: #313139;
    --gold: #e8b740;
    --on-accent: #1a1320;
    --shadow-hard: 4px 4px 0 rgba(0, 0, 0, 0.45);
  }
  .v1 .site-header {
    background: var(--panel);
    border-bottom: 1px solid var(--page-line);
  }
  .v1 .brand-word {
    font-family: var(--font-pixel);
    font-size: 14px;
    line-height: 20px;
    color: var(--page-text);
  }
  .v1 .site-nav a {
    border: 1px solid var(--page-line);
    background: var(--panel-2);
    padding: 4px 10px;
    font-size: 13px;
    color: #b3b0ac;
  }
  .v1 .site-nav a:hover {
    border-color: var(--gold);
    color: var(--page-text);
  }

  .v1-intro {
    padding-top: 22px;
    padding-bottom: 14px;
  }
  .v1 .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .v1 .hero-copy {
    flex: 1 1 520px;
    max-width: 760px;
  }
  .v1 h1 {
    margin: 0;
    font-size: clamp(26px, 2.6vw, 36px);
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .v1 .hero-desc {
    margin: 8px 0 0;
    color: #b3b0ac;
    max-width: 68ch;
  }
  .v1 .hero-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: none;
  }
  .v1 .btn-download {
    font-family: var(--font-pixel);
    font-size: 10px;
    line-height: 1;
    padding: 12px 16px;
    background: var(--gold);
    color: var(--on-accent);
    text-decoration: none;
    border: 2px solid #1a1320;
    outline: 2px solid var(--gold);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.5);
  }
  .v1 .btn-download:hover {
    transform: translate(1px, 1px);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.5);
  }
  .v1 .link-source {
    color: var(--gold);
    font-size: 14px;
    text-underline-offset: 3px;
  }
  .v1 .reel-stage {
    border-radius: 0;
    box-shadow:
      0 0 0 2px var(--gold),
      8px 8px 0 rgba(0, 0, 0, 0.55);
  }
  .v1 .reel-caption {
    font-family: var(--font-pixel);
    font-size: 8px;
    line-height: 12px;
    color: var(--gold);
    margin-top: 14px;
  }
  .v1 .site-footer {
    background: var(--panel);
  }

  @media (max-height: 760px) and (min-width: 700px) {
    .v1-intro {
      padding-top: 14px;
      padding-bottom: 10px;
    }
    .v1 .hero {
      align-items: center;
      flex-wrap: nowrap;
    }
    .v1 .hero-desc {
      display: none;
    }
    .v1 h1 {
      font-size: clamp(20px, 2.3vw, 28px);
    }
  }
</style>
