---
import BaseLayout from '../layouts/BaseLayout.astro';
import Showreel from '../components/Showreel.astro';

const RELEASES = 'https://github.com/mavericksxx/pokemon-harness/releases/latest';
const REPO = 'https://github.com/mavericksxx/pokemon-harness';
---

<BaseLayout title="pokéharness — your coding agents as pokémon" current="home">
  <div class="home">
    <div class="home-copy">
      <h1><span>your coding agents,</span><span>as pokémon</span></h1>
      <p>a mac app that shows each claude code, codex or cursor-agent session as a pokémon in a pixel-art garden, with its terminal beside it.</p>
      <div class="home-actions">
        <a class="btn-pixel" href={RELEASES}>download for mac</a>
        <a class="gold-link" href={REPO}>source ↗</a>
      </div>
    </div>
    <div class="home-reel">
      <Showreel fitMargin={24} />
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    max-width: 1600px;
    margin: 0 auto;
    padding: 12px 24px 0;
  }
  .home-copy {
    padding-bottom: 32px;
    animation: home-rise 560ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }
  h1 {
    margin: 0 0 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-pixel);
    font-size: clamp(15px, 1.7vw, 20px);
    line-height: 1.7;
    font-weight: 400;
    letter-spacing: 0;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
  }
  .home-copy p {
    margin: 0 0 24px;
    color: var(--text-soft);
    font-size: 15px;
    line-height: 1.55;
  }
  .home-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 20px;
  }
  .home-reel {
    min-width: 0;
    animation: home-rise 640ms 90ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }
  .home-reel :global(.reel-section) {
    padding: 0;
    max-width: none;
  }

  @keyframes home-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-copy,
    .home-reel {
      animation: none;
    }
  }

  @media (max-width: 1100px) {
    .home {
      grid-template-columns: minmax(240px, 280px) minmax(0, 1fr);
      gap: 28px;
    }
  }

  /* Stacked: compact copy on top, the window below. */
  @media (max-width: 900px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding-top: 16px;
    }
    .home-copy {
      padding-bottom: 0;
    }
    h1 {
      font-size: clamp(13px, 3.6vw, 16px);
      margin-bottom: 10px;
    }
    .home-copy p {
      margin-bottom: 14px;
      font-size: 14px;
    }
  }
  @media (max-width: 560px) {
    .home {
      padding: 16px 16px 0;
    }
  }
</style>
