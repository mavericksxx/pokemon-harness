---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Showreel from '../components/Showreel.astro';

const RELEASES = 'https://github.com/mavericksxx/pokemon-harness/releases/latest';
const REPO = 'https://github.com/mavericksxx/pokemon-harness';

interface Plate {
  /** Doc slug (src/content/docs/<slug>.md), or null for a feature with no page. */
  slug: string | null;
  name: string;
  note: string;
  sprite?: string;
  glyph?: string;
}

// Two plates, in the order a new visitor meets things. Every doc in
// src/content/docs has an entry; anything added later without one still
// shows up (see `uncatalogued` below) rather than silently going missing.
const gardenPlates: Plate[] = [
  { slug: 'evolution', name: 'evolution', sprite: '/sprites/raichu.gif', note: 'working time adds up. cross a threshold and the walker plays the full ceremony: a flash, a silhouette, then the new form. some evolved forms fly instead of walk.' },
  { slug: 'shiny-pokemon', name: 'shiny pokémon', sprite: '/sprites/shiny/eevee.gif', note: 'one session in sixty-four rolls a shiny coat and keeps it for life, through every stage. a sparkle burst on arrival, a small star in the record.' },
  { slug: 'subagent-battles', name: 'subagent battles', sprite: '/sprites/gastly.gif', note: 'a task call spawns a wild pokémon that roams while the subagent works. when it finishes, it walks up and fights its parent: lunges, hit flashes, move text. one battle at a time.' },
  { slug: 'mega-evolution', name: 'mega evolution', sprite: '/sprites/charizard-megax.gif', note: 'forty-six species swell into a mega form for the length of a battle, with a ring, vortex and plume ceremony, then settle back once it ends.' },
  { slug: 'arceus', name: 'arceus', sprite: '/sprites/arceus.gif', note: 'summoned, not hatched. a permanent, gold-framed orchestrator in the hall of origin that can hand work to any session in any garden.' },
  { slug: null, name: 'day and night', glyph: '☾', note: 'the garden keeps your local clock. lamps come on at dusk, the pond catches moonlight overnight, and it fades back to day at sunrise.' },
  { slug: 'pokemon-picker', name: 'pokémon picker', sprite: '/sprites/bulbasaur.gif', note: 'type-ahead over the whole #1–1025 dex. one of each evolution line at a time, and a note when your pick joins as its base stage.' },
  { slug: 'audio', name: 'audio', glyph: '♪', note: 'cries on spawn, battle sfx, and optional heartgold/soulsilver music. music starts off, sfx starts on, and every setting persists.' },
];

const harnessPlates: Plate[] = [
  { slug: 'claude-code-hooks', name: 'claude code hooks', glyph: '{ }', note: "for claude sessions, lifecycle hooks are the source of truth for what a walker is doing, so bubbles and statuses don't depend on scraping terminal text." },
  { slug: 'advisor', name: 'advisor', glyph: '?!', note: 'before a big call, or before anything is marked done, the harness consults a second session as a review gate. it hovers beside the session it advises.' },
  { slug: 'cost-tracking', name: 'cost tracking', glyph: '$', note: "each session's running dollar cost and token count, computed locally from the cli's own transcripts. a 30-day history lives in the menu bar." },
  { slug: 'usage-tracking', name: 'usage tracking', glyph: '%', note: 'opt-in and read-only: your 5-hour and 7-day rate-limit windows, straight from the provider, using the credential your cli already stores.' },
  { slug: 'menu-bar', name: 'menu bar', glyph: '◓', note: 'a pokéball glyph in the macos menu bar for as long as the app runs. click it for usage, cost history and live session counts.' },
  { slug: 'session-persistence', name: 'sessions survive quit', glyph: '∞', note: "quitting doesn't kill your agents. a detached helper keeps their terminals alive, and the app reattaches to every one on next launch." },
  { slug: 'multi-workspace', name: 'multiple gardens', glyph: '⌘', note: "run more than one project's garden at once, each with its own folder and sessions. cmd/ctrl+shift+1 through 9 jumps between them." },
  { slug: 'poke-delegate', name: 'poke-delegate', glyph: '→', note: 'dispatch a real, separately tracked codex session, with its own walker, from inside another agent’s workflow.' },
  { slug: 'harness-instructions', name: 'harness.md', glyph: 'md', note: 'an editable instructions file the harness gives every session it launches. change it once and every future session follows.' },
];

const docs = await getCollection('docs');
const catalogued = new Set([...gardenPlates, ...harnessPlates].map((p) => p.slug));
const uncatalogued: Plate[] = docs
  .filter((d) => !catalogued.has(d.id))
  .sort((a, b) => a.data.order - b.data.order)
  .map((d) => ({ slug: d.id, name: d.data.title.toLowerCase(), glyph: '·', note: 'see the field notes for this one.' }));
const harnessAll = [...harnessPlates, ...uncatalogued];
const pad = (n: number): string => String(n).padStart(2, '0');
---

<BaseLayout title="pokéharness — a field guide to your coding agents" current="home">
  <header class="intro wrap">
    <p class="kicker">a field guide · for claude, codex and cursor-agent</p>
    <div class="intro-row">
      <h1 class="serif">a field guide to your coding agents</h1>
      <div class="intro-side">
        <p>pokéharness turns every coding-agent session on your machine into a pokémon in a pixel-art garden. spawn one, and watch it work, fight, and evolve instead of staring at a terminal.</p>
        <div class="cta-row">
          <a class="stamp" href={RELEASES}>download for mac</a>
          <a class="ink-link" href={REPO}>browse the source</a>
        </div>
      </div>
    </div>
  </header>

  <Showreel />

  <section class="wrap works" aria-label="compatibility">
    <p>
      <span class="works-label">observed in the wild with</span>
      <span class="tag">claude</span><span class="tag">codex</span><span class="tag">cursor-agent</span>
    </p>
    <p class="works-note">free and open source. runs on your machine: no accounts, no cloud.</p>
  </section>

  <section class="wrap section" id="method">
    <p class="kicker">field method</p>
    <h2 class="serif">how it works</h2>
    <ol class="method">
      <li class="method-step">
        <span class="method-num serif">i.</span>
        <div class="method-body">
          <h3 class="serif">download and open it</h3>
          <p>download the .zip and drag it to applications. gatekeeper asks once: right-click, open, then open again. it won't ask after that.</p>
        </div>
        <div class="method-card" aria-hidden="true">
          <div>Pokéharness.zip</div>
          <div>→ drag to /Applications</div>
          <div>→ right-click, open, open</div>
          <div>→ never asks again</div>
        </div>
      </li>
      <li class="method-step">
        <span class="method-num serif">ii.</span>
        <div class="method-body">
          <h3 class="serif">spawn a session</h3>
          <p>point it at a project folder and pick a pokémon, or let it choose a starter. it launches claude, codex, or cursor-agent the same way you would from a terminal.</p>
        </div>
        <figure class="method-photo">
          <div class="specimen-photo"><img src="/screenshots/battle.png" alt="two walkers squared up in a battle, move text floating overhead" width="578" height="400" loading="lazy"></div>
        </figure>
      </li>
      <li class="method-step">
        <span class="method-num serif">iii.</span>
        <div class="method-body">
          <h3 class="serif">watch it work</h3>
          <p>tool calls show up as a speech bubble while the walker goes about its business. subagents spawn as battles. long sessions evolve.</p>
        </div>
        <figure class="method-photo">
          <div class="specimen-photo"><img src="/screenshots/evolution.png" alt="an evolution ceremony mid-flash, the walker's old form as a white silhouette" width="578" height="361" loading="lazy"></div>
        </figure>
      </li>
    </ol>
  </section>

  <section class="wrap section" id="catalogue">
    <p class="kicker">catalogue</p>
    <h2 class="serif">notes from the garden</h2>
    <p class="section-note">a plate of what turns up once you've been watching a while. each entry links to its full field notes.</p>

    <h3 class="plate-title serif"><span>plate i.</span> in the garden</h3>
    <div class="plate">
      {gardenPlates.map((p, i) => (
        <a class:list={['plate-row', { 'plate-row-static': !p.slug }]} href={p.slug ? `/docs/${p.slug}/` : undefined}>
          <span class="plate-num">{pad(i + 1)}</span>
          <span class="plate-thumb">
            {p.sprite ? <img src={p.sprite} alt="" loading="lazy" /> : <span class="plate-glyph">{p.glyph}</span>}
          </span>
          <span class="plate-body">
            <span class="plate-name serif">{p.name}</span>
            <span class="plate-note">{p.note}</span>
          </span>
          {p.slug && <span class="plate-more" aria-hidden="true">notes →</span>}
        </a>
      ))}
    </div>

    <h3 class="plate-title serif"><span>plate ii.</span> the harness itself</h3>
    <div class="plate">
      {harnessAll.map((p, i) => (
        <a class="plate-row" href={`/docs/${p.slug}/`}>
          <span class="plate-num">{pad(gardenPlates.length + i + 1)}</span>
          <span class="plate-thumb"><span class="plate-glyph">{p.glyph}</span></span>
          <span class="plate-body">
            <span class="plate-name serif">{p.name}</span>
            <span class="plate-note">{p.note}</span>
          </span>
          <span class="plate-more" aria-hidden="true">notes →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" id="download">
    <div class="collect">
      <div class="collect-copy">
        <p class="kicker">collecting</p>
        <h2 class="serif">take one home</h2>
        <p>pokéharness is a free macos app. it runs the agent clis you already have installed, keeps everything on your machine, and gets out of the way when you just want the terminal.</p>
        <div class="cta-row">
          <a class="stamp" href={RELEASES}>download for mac</a>
          <a class="ink-link" href="/docs/">read the field notes</a>
        </div>
      </div>
      <figure class="collect-photo">
        <div class="specimen-photo">
          <div class="specimen-pin" aria-hidden="true"></div>
          <img src="/screenshots/arceus.png" alt="the hall of origin: arceus floating in a starfield, cycling through its type-plate formes" width="578" height="361" loading="lazy">
        </div>
        <figcaption class="specimen-cap">fig. 10 — arceus, observed in the hall of origin.</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: 48px;
    padding-bottom: 28px;
  }
  .intro-row {
    display: flex;
    gap: 48px;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  h1 {
    font-weight: 500;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 640px;
    flex: 1 1 420px;
  }
  .intro-side {
    flex: 0 1 420px;
    min-width: 0;
  }
  .intro-side p {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 24px;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .works {
    margin-top: 40px;
    text-align: center;
    color: var(--ink-soft);
  }
  .works p {
    margin: 0 0 6px;
  }
  .works-label {
    font-family: var(--font-serif);
    font-style: italic;
    margin-right: 10px;
  }
  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--moss);
    border: 1px solid var(--rule-strong);
    padding: 2px 8px;
    margin: 4px 4px;
  }
  .works-note {
    font-size: 14px;
    color: var(--ink-faint);
  }

  .section {
    padding-top: 88px;
  }
  h2 {
    font-weight: 500;
    font-size: clamp(26px, 3.2vw, 34px);
    line-height: 1.15;
    margin: 0 0 10px;
  }
  .section-note {
    color: var(--ink-soft);
    margin: 0 0 36px;
    max-width: 520px;
  }

  /* field method */
  .method {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .method-step {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 340px);
    gap: 24px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }
  .method-num {
    font-style: italic;
    font-size: 30px;
    color: var(--rust);
  }
  .method-body h3 {
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 6px;
  }
  .method-body p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 460px;
  }
  .method-card {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.9;
    color: var(--ink-soft);
    background: var(--paper-deep);
    box-shadow: inset 0 0 0 1px var(--rule);
    padding: 16px 18px;
  }
  .method-card div:first-child {
    color: var(--ink);
  }
  .method-photo {
    margin: 0 8px;
  }
  .method-photo img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }
  .method-step:nth-child(2) .specimen-photo {
    transform: rotate(-0.8deg);
  }
  .method-step:nth-child(3) .specimen-photo {
    transform: rotate(0.7deg);
  }

  /* catalogue plates */
  .plate-title {
    font-weight: 500;
    font-style: italic;
    font-size: 18px;
    margin: 40px 0 12px;
    color: var(--ink);
  }
  .plate-title span {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 12px;
    color: var(--gold-ink);
    margin-right: 8px;
    letter-spacing: 0.04em;
  }
  .plate {
    border-top: 1px solid var(--rule);
  }
  .plate-row {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 16px 6px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    transition: background 120ms ease;
  }
  a.plate-row[href]:hover {
    background: var(--moss-wash);
  }
  .plate-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gold-ink);
    flex: 0 0 24px;
  }
  .plate-thumb {
    flex: 0 0 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-deep);
    box-shadow: inset 0 0 0 1px var(--rule);
    overflow: hidden;
  }
  .plate-thumb img {
    max-width: 44px;
    max-height: 44px;
    image-rendering: pixelated;
  }
  .plate-glyph {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--moss);
  }
  .plate-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .plate-name {
    font-weight: 600;
    font-size: 17px;
    margin: 0 0 3px;
  }
  .plate-note {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .plate-more {
    flex: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--rust);
    opacity: 0.8;
  }

  /* download */
  .collect {
    display: flex;
    gap: 56px;
    align-items: center;
    flex-wrap: wrap;
    border: 1px solid var(--rule-strong);
    box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 5px var(--rule);
    padding: 44px;
  }
  .collect-copy {
    flex: 1 1 360px;
    min-width: 0;
  }
  .collect-copy p {
    color: var(--ink-soft);
    max-width: 460px;
    margin: 0 0 26px;
  }
  .collect-photo {
    flex: 0 1 400px;
    min-width: 0;
    margin: 0;
  }
  .collect-photo .specimen-photo {
    transform: rotate(1deg);
  }
  .collect-photo img {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  @media (max-width: 820px) {
    .method-step {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .method-card,
    .method-photo {
      grid-column: 2;
    }
  }
  @media (max-width: 560px) {
    .intro {
      padding-top: 32px;
    }
    .intro-row {
      gap: 20px;
    }
    .plate-row {
      gap: 12px;
      align-items: flex-start;
    }
    .plate-num {
      flex-basis: 18px;
      padding-top: 2px;
    }
    .plate-thumb {
      flex-basis: 40px;
      height: 40px;
    }
    .plate-thumb img {
      max-width: 34px;
      max-height: 34px;
    }
    .plate-more {
      display: none;
    }
    .collect {
      padding: 28px 20px;
      gap: 32px;
    }
    .section {
      padding-top: 64px;
    }
  }
</style>
