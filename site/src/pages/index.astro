---
import BaseLayout from '../layouts/BaseLayout.astro';
import Showreel from '../components/Showreel.astro';

const RELEASES = 'https://github.com/mavericksxx/pokemon-harness/releases/latest';
const REPO = 'https://github.com/mavericksxx/pokemon-harness';
---

<BaseLayout title="pokéharness — your coding agents as pokémon" current="home">
  <header class="intro wrap">
    <p class="kicker">for claude code, codex and cursor-agent</p>
    <div class="intro-row">
      <h1 class="serif">your coding agents, as pokémon in a garden</h1>
      <div class="intro-side">
        <p>pokéharness is a macos app that runs your claude code, codex and cursor-agent sessions and shows each one as a pokémon in a pixel-art garden, with its terminal alongside.</p>
        <div class="cta-row">
          <a class="stamp" href={RELEASES}>download for mac</a>
          <a class="ink-link" href={REPO}>browse the source</a>
        </div>
      </div>
    </div>
  </header>

  <Showreel />
</BaseLayout>

<style>
  .intro {
    padding-top: 22px;
    padding-bottom: 16px;
  }
  .intro .kicker {
    margin-bottom: 8px;
  }
  .intro-row {
    display: flex;
    gap: 48px;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  h1 {
    font-weight: 500;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 640px;
    flex: 1 1 420px;
  }
  .intro-side {
    flex: 0 1 420px;
    min-width: 0;
  }
  .intro-side {
    padding-top: 6px;
  }
  .intro-side p {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 16px;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .intro {
      padding-top: 32px;
    }
    .intro-row {
      gap: 20px;
    }
  }

  /* Short viewports (laptops with browser chrome): a one-row hero so the
     headline, CTA and the whole showreel window fit without scrolling. */
  @media (max-height: 760px) and (min-width: 700px) {
    .intro {
      padding-top: 12px;
      padding-bottom: 10px;
    }
    .intro .kicker,
    .intro-side p {
      display: none;
    }
    .intro-row {
      align-items: center;
      flex-wrap: nowrap;
      gap: 24px;
    }
    h1 {
      font-size: clamp(22px, 2.6vw, 32px);
      max-width: none;
      flex: 1 1 auto;
    }
    .intro-side {
      flex: none;
    }
    .cta-row {
      flex-wrap: nowrap;
    }
    .stamp {
      padding: 8px 16px;
      font-size: 14px;
    }
  }
</style>
