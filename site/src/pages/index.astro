---
import BaseLayout from '../layouts/BaseLayout.astro';
import Showreel from '../components/Showreel.astro';

const RELEASES = 'https://github.com/mavericksxx/pokemon-harness/releases/latest';
const REPO = 'https://github.com/mavericksxx/pokemon-harness';
---

<BaseLayout title="pokéharness — your coding agents as pokémon" current="home">
  <div class="home">
    <div class="home-copy">
      <h1><span>your coding agents,</span><span>as pokémon</span></h1>
      <p>a mac app that shows each claude code, codex or cursor-agent session as a pokémon in a pixel-art garden, with its terminal beside it.</p>
      <div class="home-actions">
        <a class="btn-pixel" href={RELEASES}>download for mac</a>
        <a class="gold-link" href={REPO}>source ↗</a>
      </div>
    </div>
    <div class="home-reel">
      <Showreel fitMargin={96} />
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(300px, 352px) minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(40px, 4.5vw, 72px);
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin: 0 auto;
    min-height: calc(100svh - var(--header-h) - 48px);
    padding: 16px var(--gutter) 32px;
  }
  .home-copy {
    padding-bottom: 32px;
  }
  h1 {
    margin: 0 0 24px;
    font-family: var(--font-ui);
    font-size: clamp(40px, 3.6vw, 56px);
    line-height: 1.02;
    font-weight: 650;
    letter-spacing: -0.035em;
    color: var(--text);
    text-wrap: balance;
  }
  h1 span {
    display: block;
  }
  .home-copy p {
    margin: 0 0 40px;
    max-width: 34ch;
    color: var(--text-soft);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .home-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 32px;
  }
  .home-reel {
    min-width: 0;
  }
  .home-reel :global(.reel-section) {
    padding: 0;
    max-width: none;
  }
  .home-reel :global(.reel-stage) {
    margin-right: 0;
  }
  .home-reel :global(.reel-caption) {
    justify-content: flex-end;
  }

  @media (max-width: 1100px) {
    .home {
      grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
    }
    h1 {
      font-size: 40px;
    }
    .home-copy p {
      font-size: 16px;
      margin-bottom: 32px;
    }
  }

  /* Stacked: copy on top, the window below. */
  @media (max-width: 900px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
      min-height: 0;
      padding-top: 24px;
    }
    .home-copy {
      padding-bottom: 0;
    }
    h1 {
      font-size: clamp(32px, 8vw, 40px);
      margin-bottom: 16px;
    }
    .home-copy p {
      margin-bottom: 24px;
    }
  }
</style>
