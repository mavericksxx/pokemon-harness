---
import BaseLayout from '../layouts/BaseLayout.astro';
import Showreel from '../components/Showreel.astro';

const RELEASES = 'https://github.com/mavericksxx/pokemon-harness/releases/latest';
const REPO = 'https://github.com/mavericksxx/pokemon-harness';
---

<BaseLayout title="pokéharness — your coding agents as pokémon" current="home">
  <div class="home">
    <div class="home-reel">
      <Showreel fitMargin={150} maxWidth={1520} />
    </div>
    <div class="home-actions">
      <a class="btn-pixel" href={RELEASES}>download for mac</a>
      <a class="gold-link" href={REPO}>source ↗</a>
    </div>
    <p class="home-copy">a mac app that shows each claude code, codex or cursor-agent session as a pokémon in a pixel-art garden, with its terminal beside it.</p>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 20px var(--gutter) 32px;
  }
  .home-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin: 20px 0 0;
  }
  .home-reel :global(.reel-section) {
    padding: 0;
    max-width: none;
  }
  .home-copy {
    margin: 24px auto 0;
    max-width: 56ch;
    text-align: center;
    color: var(--text-soft);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .home {
      padding-top: 16px;
    }
    .home-copy {
      font-size: 16px;
    }
  }
</style>
