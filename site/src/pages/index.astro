---
import BaseLayout from '../layouts/BaseLayout.astro';
import Showreel from '../components/Showreel.astro';

const RELEASES = 'https://github.com/mavericksxx/pokemon-harness/releases/latest';
const REPO = 'https://github.com/mavericksxx/pokemon-harness';
---

<BaseLayout title="pokéharness — your coding agents as pokémon" current="home">
  <div class="home">
    <div class="home-copy">
      <h1>your coding agents, as pokémon</h1>
      <p>a mac app that shows each claude code, codex or cursor-agent session as a pokémon in a pixel-art garden, with its terminal beside it.</p>
      <div class="home-actions">
        <a class="btn-pixel" href={RELEASES}>download for mac</a>
        <a class="gold-link" href={REPO}>source ↗</a>
      </div>
    </div>
    <div class="home-reel">
      <Showreel fitMargin={24} />
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    max-width: 1600px;
    margin: 0 auto;
    padding: 12px 24px 0;
  }
  .home-copy {
    padding-bottom: 32px;
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.12;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .home-copy p {
    margin: 0 0 24px;
    color: var(--text-soft);
    font-size: 15px;
    line-height: 1.55;
  }
  .home-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px 20px;
  }
  .home-reel {
    min-width: 0;
  }
  .home-reel :global(.reel-section) {
    padding: 0;
    max-width: none;
  }

  @media (max-width: 1100px) {
    .home {
      grid-template-columns: minmax(240px, 280px) minmax(0, 1fr);
      gap: 28px;
    }
  }

  /* Stacked: compact copy on top, the window below. */
  @media (max-width: 900px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding-top: 16px;
    }
    .home-copy {
      padding-bottom: 0;
    }
    h1 {
      font-size: clamp(24px, 5vw, 30px);
      margin-bottom: 6px;
    }
    .home-copy p {
      margin-bottom: 14px;
      font-size: 14px;
    }
  }
  @media (max-width: 560px) {
    .home {
      padding: 16px 16px 0;
    }
  }
</style>
