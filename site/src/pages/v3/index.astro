---
import VariantLayout from '../../layouts/VariantLayout.astro';
import VariantHero from '../../components/VariantHero.astro';
import Showreel from '../../components/Showreel.astro';
---

<VariantLayout variant="v3" themeColor="#0d1014">
  <div class="v3-backdrop" aria-hidden="true"></div>
  <section class="wrap v3-intro"><VariantHero /></section>
  <Showreel fitMargin={44} />
</VariantLayout>

<style is:global>
  /* v3 "garden backdrop": the app's own kenney tiny-town grass and trees
     (public/backdrop/garden-pattern.png, composed from assets/garden),
     tiled pixelated behind a cool dark scrim. */
  body.v3 {
    --page-bg: #0d1014;
    --panel: #1d1d22;
    --page-text: #dedbd6;
    --page-muted: #a3a0ac;
    --page-line: #313139;
    --gold: #e8b740;
    position: relative;
    isolation: isolate;
  }
  .v3-backdrop {
    position: fixed;
    inset: -8px;
    z-index: -1;
    background: url('/backdrop/garden-pattern.png') 0 0 / 1536px auto repeat;
    image-rendering: pixelated;
    filter: blur(1.5px) saturate(0.7) brightness(0.8);
  }
  .v3-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 55%, rgba(10, 13, 18, 0.45), rgba(10, 13, 18, 0.8) 80%);
  }
  .v3 .site-header {
    background: rgba(17, 19, 23, 0.9);
    border-bottom: 1px solid var(--page-line);
  }
  .v3 .brand-word {
    font-family: var(--font-pixel);
    font-size: 13px;
    line-height: 20px;
  }
  .v3 .site-nav a {
    color: #c9c6c1;
  }
  .v3-intro {
    padding-top: 18px;
    padding-bottom: 14px;
  }
  .v3 .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    flex-wrap: wrap;
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px 22px;
    background: var(--panel);
    border: 1px solid #787684;
    box-shadow:
      inset 0 0 0 1px #1d1d22,
      inset 0 0 0 3px var(--gold),
      6px 6px 0 rgba(0, 0, 0, 0.5);
  }
  .v3 .hero-copy {
    flex: 1 1 460px;
  }
  .v3 h1 {
    margin: 0;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .v3 .hero-desc {
    margin: 6px 0 0;
    color: #b3b0ac;
    font-size: 14px;
    max-width: 66ch;
  }
  .v3 .hero-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .v3 .btn-download {
    background: var(--gold);
    color: #1a1320;
    font-weight: 700;
    font-size: 14px;
    padding: 9px 16px;
    text-decoration: none;
    border: 2px solid #1a1320;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.6);
  }
  .v3 .link-source {
    color: var(--gold);
    font-size: 14px;
    text-underline-offset: 3px;
  }
  .v3 .reel-stage {
    border-radius: 10px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 30px 80px rgba(0, 0, 0, 0.75);
  }
  .v3 .reel-caption {
    color: #c9c6c1;
  }
  .v3 .site-footer {
    background: rgba(17, 19, 23, 0.92);
  }

  @media (max-height: 760px) and (min-width: 700px) {
    .v3-intro {
      padding-top: 10px;
      padding-bottom: 8px;
    }
    .v3 .hero {
      padding: 10px 18px;
      flex-wrap: nowrap;
    }
    .v3 .hero-desc {
      display: none;
    }
    .v3 h1 {
      font-size: clamp(18px, 2vw, 24px);
    }
  }
</style>
