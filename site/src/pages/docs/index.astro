---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number): string => String(n).padStart(2, '0');
---

<BaseLayout title="docs · pokéharness" current="docs">
  <div class="wrap notes">
    <h1 class="serif">docs</h1>
    <p class="lede">one page per feature.</p>
    <p class="intro">
      pokéharness is a free, open-source macos app for claude code, codex and
      cursor-agent: download the .zip, drag it to /Applications, then
      right-click → open once past gatekeeper. point it at a project folder
      and pick a pokémon (or let it choose a starter) to spawn a session —
      tool calls show up as a speech bubble, subagents spawn as battles, and
      long sessions evolve. everything runs on your machine: no accounts, no
      cloud.
    </p>
    <ol class="notes-list">
      {allDocs.map((doc, i) => (
        <li>
          <a href={`/docs/${doc.id}/`}>
            <span class="notes-num">{pad(i + 1)}</span>
            <span class="notes-title serif">{doc.data.title}</span>
            <span class="notes-more" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .notes {
    max-width: 760px;
    padding-top: 48px;
  }
  h1 {
    font-weight: 500;
    font-size: clamp(32px, 4.5vw, 46px);
    line-height: 1.1;
    margin: 0 0 10px;
  }
  .lede {
    color: var(--ink-soft);
    margin: 0 0 12px;
  }
  .intro {
    color: var(--ink-soft);
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .notes-list a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 6px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .notes-list a:hover {
    background: var(--moss-wash);
  }
  .notes-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--gold-ink);
    flex: 0 0 22px;
  }
  .notes-title {
    flex: 1;
    min-width: 0;
    font-size: 18px;
    font-weight: 500;
  }
  .notes-more {
    font-family: var(--font-serif);
    color: var(--rust);
  }
</style>
