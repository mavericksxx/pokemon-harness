---
import { getCollection } from 'astro:content';

const allDocs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>docs · pokéharness</title>
<link rel="icon" type="image/png" href="/favicon.png">

<style>
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/inter-latin-var.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Press Start 2P';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/press-start-2p-latin-400.woff2') format('woff2');
  }

  :root {
    --ground-0: #17171B;
    --ground-100: #1D1D22;
    --ink-900: #DEDBD6;
    --ink-700: #B3B0AC;
    --gold: #E8B740;
    --font-display: 'Press Start 2P', monospace;
    --font-ui: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }

  * { box-sizing: border-box; }
  html { color-scheme: dark; }
  body {
    margin: 0;
    background: var(--ground-0);
    color: var(--ink-900);
    font-family: var(--font-ui);
    line-height: 1.5;
  }
  a.brand {
    display: block;
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--gold);
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 16px 24px;
    border-bottom: 1px solid rgba(120, 118, 132, 0.2);
  }
  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 48px 24px;
  }
  h1 { font-size: 28px; margin: 0 0 24px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin: 0 0 8px; }
  a.doc-link {
    display: block;
    padding: 14px 16px;
    background: var(--ground-100);
    box-shadow: inset 0 0 0 1px rgba(120, 118, 132, 0.2);
    color: var(--ink-900);
    text-decoration: none;
    font-weight: 600;
  }
  a.doc-link:hover { color: var(--gold); }
</style>
</head>
<body>
<a class="brand" href="/">pokéharness</a>
<div class="wrap">
  <h1>docs</h1>
  <ul>
    {allDocs.map((doc) => (
      <li><a class="doc-link" href={`/docs/${doc.id}/`}>{doc.data.title}</a></li>
    ))}
  </ul>
</div>
</body>
</html>
