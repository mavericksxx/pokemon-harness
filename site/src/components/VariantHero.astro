---
/** Hero copy shared by the /v1-/v3 variations; each page styles it. */
const RELEASES = 'https://github.com/mavericksxx/pokemon-harness/releases/latest';
const REPO = 'https://github.com/mavericksxx/pokemon-harness';
---
<div class="hero">
  <div class="hero-copy">
    <h1>your coding agents, as pokémon in a garden</h1>
    <p class="hero-desc">a mac app that runs your claude code, codex and cursor-agent sessions and shows each one as a pokémon walking around a pixel-art garden, with its terminal right beside it.</p>
  </div>
  <div class="hero-actions">
    <a class="btn-download" href={RELEASES}>download for mac</a>
    <a class="link-source" href={REPO}>browse the source</a>
  </div>
</div>
