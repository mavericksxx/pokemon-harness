---
/**
 * Full-width hero showreel: the pokéharness app window, rendered at a fixed
 * 1440x900 design size and CSS-scaled to the hero's width. Server-renders
 * only the window frame with a screenshot poster — which is also what
 * prefers-reduced-motion visitors (and anyone without WebGL) keep seeing.
 * The live window (the app's own components + the real Pixi garden) is a
 * client-only script (src/showreel/boot.ts), lazy-loaded near the viewport.
 */
import '../styles/showreel.css';
---

<section class="reel-section" aria-label="pokéharness running a few coding sessions">
  <div class="reel-stage" data-reel>
    <div class="reel-scaler" data-reel-scaler>
      <div class="reel-window">
        <img
          class="reel-poster"
          src="/screenshots/garden.png"
          alt="the pokéharness window: agent cards on the left, the pixel-art garden with pokémon walkers in the middle, and a terminal on the right"
          width="1210"
          height="752"
        >
        <div class="reel-app" data-reel-window aria-hidden="true"></div>
        <span class="reel-lights" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    </div>
  </div>
  <p class="reel-caption" data-reel-caption>subagent battle</p>
</section>

<script>
  import { bootShowreel } from '../showreel/boot';
  bootShowreel();
</script>
