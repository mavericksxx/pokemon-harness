{
  "name": "pokeharness",
  "productName": "Pokéharness",
  "version": "1.6.0",
  "private": true,
  "description": "Local-only desktop coding harness: coding-agent CLI sessions visualized as Pokemon walking around a pixel-art garden.",
  "main": "out/main/index.js",
  "author": "parthkohale@gmail.com",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild -f -w node-pty && node tools/ensure-pty-perms.cjs",
    "gen:map": "node tools/gen-garden-map.cjs",
    "gen:dex": "node tools/build-dex.cjs",
    "gen:music-catalog": "node tools/build-music-catalog.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "gen:icon": "node build/icon/gen-icon.mjs",
    "gen:tahoe-icon": "node build/icon/gen-tahoe-icon.mjs",
    "dist": "npm run build && electron-builder --mac",
    "release": "node tools/release.cjs"
  },
  "build": {
    "appId": "dev.mavericksxx.pokeharness",
    "productName": "Pokeharness",
    "copyright": "Copyright © 2026 Parth Kohale",
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "Pokéharness",
        "CFBundleIconName": "PokeharnessIcon"
      },
      "extraResources": [
        {
          "from": "build/Assets.car",
          "to": "Assets.car"
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "afterSign": "build/afterSign.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "gifuct-js": "^2.1.2",
    "howler": "^2.2.4",
    "node-pty": "^1.0.0",
    "pixi.js": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "@electron/rebuild": "^3.7.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
